{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroHQ AI Expert Profile",
  "type": "object",
  "required": [
    "profile_id",
    "display_name",
    "slug",
    "discipline",
    "tagline",
    "audience",
    "specialisations",
    "identity",
    "persona",
    "consultation_method",
    "boundaries"
  ],
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "discipline": {
      "enum": [
        "vedic_astrology",
        "kp_astrology",
        "tarot",
        "numerology",
        "dream_interpretation"
      ]
    },
    "tagline": {
      "type": "string"
    },
    "audience": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "specialisations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object"
    },
    "persona": {
      "type": "object"
    },
    "consultation_method": {
      "type": "object"
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}